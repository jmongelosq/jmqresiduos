<?xml version='1.0' encoding='UTF-8'?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" whenNoDataType="AllSectionsNoDetail" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informe_servicios" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" uuid="5f4c4d8e-2f51-4a42-9d3a-100000000001">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="DESDE" class="java.sql.Date"/>
	<parameter name="HASTA" class="java.sql.Date"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT
            s.id_servicio,
            c.nombre || ' ' || c.apellido AS nombre_cliente,
            s.tipo_servicio,
            s.nombre_establecimiento,
            b.nombre AS nombre_barrio,
            s.frecuencia,
            s.fecha_inicio,
            s.fecha_fin,
            s.estado
        FROM servicio s
        INNER JOIN clientes c ON s.id_cliente = c.id_cliente
        LEFT JOIN barrio b ON s.id_barrio = b.id_barrio
        WHERE s.fecha_inicio BETWEEN $P{DESDE} AND $P{HASTA}
        ORDER BY s.fecha_inicio ASC, s.id_servicio ASC]]>
	</queryString>
	<field name="id_servicio" class="java.lang.Integer"/>
	<field name="nombre_cliente" class="java.lang.String"/>
	<field name="tipo_servicio" class="java.lang.String"/>
	<field name="nombre_establecimiento" class="java.lang.String"/>
	<field name="nombre_barrio" class="java.lang.String"/>
	<field name="frecuencia" class="java.lang.String"/>
	<field name="fecha_inicio" class="java.sql.Date"/>
	<field name="fecha_fin" class="java.sql.Date"/>
	<field name="estado" class="java.lang.String"/>
