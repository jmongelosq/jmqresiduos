<?xml version='1.0' encoding='UTF-8'?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" whenNoDataType="AllSectionsNoDetail" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informe_recolecciones" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" uuid="d20f511d-e356-40b8-bf20-a45490bc2e91">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="DESDE" class="java.sql.Date"/>
	<parameter name="HASTA" class="java.sql.Date"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT r.id_recoleccion, r.fecha, ru.nombre AS nombre_ruta, v.chapa, p.nombre || ' ' || p.apellido AS nombre_responsable, r.cantidad_recolectada, r.unidad_medida, r.estado, r.observaciones FROM recoleccion r INNER JOIN asignacion a ON r.id_asignacion = a.id_asignacion INNER JOIN ruta ru ON a.id_ruta = ru.id_ruta INNER JOIN vehiculo v ON a.id_vehiculo = v.id_vehiculo INNER JOIN personal p ON a.id_personal_responsable = p.id_personal WHERE r.fecha BETWEEN $P{DESDE} AND $P{HASTA} ORDER BY r.fecha DESC, r.id_recoleccion DESC]]>
	</queryString>
	<field name="id_recoleccion" class="java.lang.Integer"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="nombre_ruta" class="java.lang.String"/>
	<field name="chapa" class="java.lang.String"/>
	<field name="nombre_responsable" class="java.lang.String"/>
	<field name="cantidad_recolectada" class="java.math.BigDecimal"/>
	<field name="unidad_medida" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="observaciones" class="java.lang.String"/>
