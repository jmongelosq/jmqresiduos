<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" whenNoDataType="AllSectionsNoDetail" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informe_pagos" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" uuid="1a2b3c4d-5e6f-47a8-9b01-c2d3e4f50617">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="278"/>
	<property name="ireport.y" value="0"/>
	<parameter name="DESDE" class="java.sql.Date"/>
	<parameter name="HASTA" class="java.sql.Date"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT
                p.id_pago,
                p.id_factura,
                p.fecha_pago,
                p.periodo,
                p.monto,
                p.metodo_pago,
                p.numero_recibo,
                p.estado,
                c.nombre || ' ' || c.apellido AS nombre_cliente,
                f.numero_factura
            FROM pago p
            LEFT JOIN factura f
                ON p.id_factura = f.id_factura
            LEFT JOIN clientes c
                ON f.id_cliente = c.id_cliente
            WHERE p.fecha_pago BETWEEN $P{DESDE} AND $P{HASTA}
            ORDER BY p.fecha_pago DESC, p.id_pago DESC]]>
	</queryString>
	<field name="id_pago" class="java.lang.Integer"/>
	<field name="id_factura" class="java.lang.Integer"/>
	<field name="fecha_pago" class="java.sql.Date"/>
	<field name="periodo" class="java.lang.String"/>
	<field name="monto" class="java.math.BigDecimal"/>
	<field name="metodo_pago" class="java.lang.String"/>
	<field name="numero_recibo" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="nombre_cliente" class="java.lang.String"/>
	<field name="numero_factura" class="java.lang.String"/>
