	<detail>
		<band height="30">
			<rectangle>
				<reportElement x="0" y="0" width="782" height="30" mode="Opaque" forecolor="#F5F8FC" backcolor="#F5F8FC" uuid="bb8d3fdf-5300-4eb5-b65b-1982b0dd19de" stretchType="RelativeToBandHeight">
					<printWhenExpression><![CDATA[$V{REPORT_COUNT}.intValue() % 2 == 0]]></printWhenExpression>
				</reportElement>
				<graphicElement>
					<pen lineWidth="0" lineColor="#F5F8FC"/>
				</graphicElement>
			</rectangle>
			<!-- ID -->
			<textField>
				<reportElement x="0" y="0" width="40" height="27" forecolor="#333333" uuid="61000000-0000-0000-0000-000000000017"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.3" lineColor="#D5DDE5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{id_servicio}]]></textFieldExpression>
			</textField>
			<!-- CLIENTE -->
			<textField>
				<reportElement x="40" y="0" width="115" height="27" forecolor="#333333" uuid="61000000-0000-0000-0000-000000000018"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.3" lineColor="#D5DDE5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[
$F{nombre_cliente} == null ? "" : $F{nombre_cliente}
                ]]></textFieldExpression>
			</textField>
			<!-- TIPO -->
			<textField>
				<reportElement x="155" y="0" width="80" height="27" forecolor="#333333" uuid="61000000-0000-0000-0000-000000000019"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.3" lineColor="#D5DDE5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[
$F{tipo_servicio} == null
? ""
: (
    $F{tipo_servicio}.equalsIgnoreCase("DOMICILIARIO")
    ? "Domiciliario"
    : $F{tipo_servicio}.equalsIgnoreCase("COMERCIAL")
        ? "Comercial"
        : $F{tipo_servicio}.equalsIgnoreCase("INDUSTRIAL")
            ? "Industrial"
            : $F{tipo_servicio}.equalsIgnoreCase("INSTITUCIONAL")
                ? "Institucional"
                : $F{tipo_servicio}.equalsIgnoreCase("ESPECIAL")
                    ? "Especial"
                    : $F{tipo_servicio}
)
                ]]></textFieldExpression>
			</textField>
			<!-- ESTABLECIMIENTO -->
			<textField>
				<reportElement x="235" y="0" width="105" height="27" forecolor="#333333" uuid="61000000-0000-0000-0000-000000000020"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.3" lineColor="#D5DDE5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[
$F{nombre_establecimiento} == null ? "" : $F{nombre_establecimiento}
                ]]></textFieldExpression>
			</textField>
			<!-- BARRIO -->
			<textField>
				<reportElement x="340" y="0" width="85" height="27" forecolor="#333333" uuid="61000000-0000-0000-0000-000000000021"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.3" lineColor="#D5DDE5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[
$F{nombre_barrio} == null ? "" : $F{nombre_barrio}
                ]]></textFieldExpression>
			</textField>
			<!-- FRECUENCIA -->
			<textField>
				<reportElement x="425" y="0" width="70" height="27" forecolor="#333333" uuid="61000000-0000-0000-0000-000000000022"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.3" lineColor="#D5DDE5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[
$F{frecuencia} == null
? ""
: (
    $F{frecuencia}.equalsIgnoreCase("MENSUAL")
    ? "Mensual"
    : $F{frecuencia}.equalsIgnoreCase("QUINCENAL")
        ? "Quincenal"
        : $F{frecuencia}.equalsIgnoreCase("SEMANAL")
            ? "Semanal"
            : $F{frecuencia}.equalsIgnoreCase("DIARIA")
                ? "Diaria"
                : $F{frecuencia}
)
                ]]></textFieldExpression>
			</textField>
			<!-- TARIFA -->
			<textField>
				<reportElement x="495" y="0" width="100" height="27" forecolor="#333333" uuid="61000000-0000-0000-0000-000000000023"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.3" lineColor="#D5DDE5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[
$F{nombre_tarifa} == null ? "" : $F{nombre_tarifa}
                ]]></textFieldExpression>
			</textField>
			<!-- MONTO -->
			<textField>
				<reportElement x="595" y="0" width="75" height="27" forecolor="#333333" uuid="61000000-0000-0000-0000-000000000024"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.3" lineColor="#D5DDE5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[
$F{monto_tarifa} == null
? ""
: "₲ " + new java.text.DecimalFormat(
    "#,##0",
    new java.text.DecimalFormatSymbols(new java.util.Locale("es", "PY"))
).format($F{monto_tarifa})
                ]]></textFieldExpression>
			</textField>
			<!-- FECHA INICIO -->
			<textField pattern="dd/MM/yyyy">
				<reportElement x="670" y="0" width="55" height="27" forecolor="#333333" uuid="61000000-0000-0000-0000-000000000025"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.3" lineColor="#D5DDE5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{fecha_inicio}]]></textFieldExpression>
			</textField>
			<!-- ESTADO -->
			<textField>
