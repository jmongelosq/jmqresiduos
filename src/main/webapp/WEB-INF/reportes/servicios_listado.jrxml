<?xml version='1.0' encoding='UTF-8'?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="servicios_listado" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" uuid="61000000-0000-0000-0000-000000000001">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="418"/>
	<property name="ireport.y" value="0"/>
	<parameter name="usuarioImpresion" class="java.lang.String"/>
	<queryString>
        <![CDATA[
SELECT
    s.id_servicio,
    (c.nombre || ' ' || c.apellido) AS nombre_cliente,
    s.tipo_servicio,
    s.nombre_establecimiento,
    s.direccion_servicio,
    b.nombre AS nombre_barrio,
    s.frecuencia,
    t.nombre AS nombre_tarifa,
    t.monto AS monto_tarifa,
    s.fecha_inicio,
    s.fecha_fin,
    s.estado,
    s.observaciones
FROM servicio s
INNER JOIN clientes c
    ON s.id_cliente = c.id_cliente
LEFT JOIN barrio b
    ON s.id_barrio = b.id_barrio
LEFT JOIN tarifa t
    ON s.id_tarifa = t.id_tarifa
ORDER BY s.id_servicio
        ]]>
    </queryString>
	<field name="id_servicio" class="java.lang.Integer"/>
	<field name="nombre_cliente" class="java.lang.String"/>
	<field name="tipo_servicio" class="java.lang.String"/>
	<field name="nombre_establecimiento" class="java.lang.String"/>
	<field name="direccion_servicio" class="java.lang.String"/>
	<field name="nombre_barrio" class="java.lang.String"/>
	<field name="frecuencia" class="java.lang.String"/>
	<field name="nombre_tarifa" class="java.lang.String"/>
	<field name="monto_tarifa" class="java.math.BigDecimal"/>
	<field name="fecha_inicio" class="java.sql.Date"/>
	<field name="fecha_fin" class="java.sql.Date"/>
	<field name="estado" class="java.lang.String"/>
	<field name="observaciones" class="java.lang.String"/>
