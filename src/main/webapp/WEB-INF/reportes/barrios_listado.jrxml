	<queryString>
		<![CDATA[SELECT
                id_barrio,
                nombre,
                descripcion,
                CASE
                    WHEN estado = TRUE
                    THEN 'ACTIVO'
                    ELSE 'INACTIVO'
                END AS estado
            FROM barrio
            ORDER BY id_barrio]]>
