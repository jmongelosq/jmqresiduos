<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="usuarios_listado" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" uuid="10000000-0000-0000-0000-000000000001">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="usuarioImpresion" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
                u.id_usuario,
                u.nombre_usuario,
                u.nombre_completo,
                u.correo,
                u.id_personal,
                u.id_rol,
                u.estado,
                u.fecha_creacion,
                p.nombre || ' ' || p.apellido AS nombre_personal,
                r.nombre_rol
            FROM usuarios u
            LEFT JOIN personal p
                ON u.id_personal = p.id_personal
            LEFT JOIN roles r
                ON u.id_rol = r.id_rol
            ORDER BY u.id_usuario]]>
	</queryString>
	<field name="id_usuario" class="java.lang.Integer"/>
	<field name="nombre_usuario" class="java.lang.String"/>
	<field name="nombre_completo" class="java.lang.String"/>
	<field name="correo" class="java.lang.String"/>
	<field name="nombre_personal" class="java.lang.String"/>
	<field name="nombre_rol" class="java.lang.String"/>
	<field name="estado" class="java.lang.Boolean"/>
	<field name="fecha_creacion" class="java.sql.Timestamp"/>
