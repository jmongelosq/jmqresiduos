	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="idServicio" class="java.lang.Integer"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT
            s.id_servicio,
            c.nombre || ' ' || c.apellido AS nombre_cliente,
            s.id_tarifa,
            t.nombre AS nombre_tarifa,
            t.monto AS monto_tarifa,
            s.tipo_servicio,
            s.nombre_establecimiento,
            s.direccion_servicio,
            b.nombre AS nombre_barrio,
            s.frecuencia,
            s.fecha_inicio,
            s.fecha_fin,
            s.estado,
            s.observaciones
        FROM servicio s
        INNER JOIN clientes c ON s.id_cliente = c.id_cliente
        LEFT JOIN tarifa t ON s.id_tarifa = t.id_tarifa
        LEFT JOIN barrio b ON s.id_barrio = b.id_barrio
        WHERE s.id_servicio = $P{idServicio}]]>
	</queryString>
	<field name="id_servicio" class="java.lang.Integer"/>
	<field name="nombre_cliente" class="java.lang.String"/>
	<field name="id_tarifa" class="java.lang.Integer"/>
	<field name="nombre_tarifa" class="java.lang.String"/>
	<field name="monto_tarifa" class="java.math.BigDecimal"/>
	<field name="tipo_servicio" class="java.lang.String"/>
	<field name="nombre_establecimiento" class="java.lang.String"/>
	<field name="direccion_servicio" class="java.lang.String"/>
	<field name="nombre_barrio" class="java.lang.String"/>
	<field name="frecuencia" class="java.lang.String"/>
	<field name="fecha_inicio" class="java.sql.Date"/>
	<field name="fecha_fin" class="java.sql.Date"/>
	<field name="estado" class="java.lang.String"/>
	<field name="observaciones" class="java.lang.String"/>
