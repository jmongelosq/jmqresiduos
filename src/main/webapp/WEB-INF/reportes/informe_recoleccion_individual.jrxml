				<textFieldExpression><![CDATA[
$F{estado} == null ? "" :
(
    ("t".equalsIgnoreCase($F{estado}.toString()) ||
     "true".equalsIgnoreCase($F{estado}.toString()))
    ? "Completada"
    : "Pendiente"
)
]]></textFieldExpression>
