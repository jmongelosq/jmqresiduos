	<parameter name="ID_RECOLECCION" class="java.lang.Integer"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT r.id_recoleccion, r.fecha, ru.nombre AS nombre_ruta, v.chapa, p.nombre || ' ' || p.apellido AS nombre_responsable, r.cantidad_recolectada, r.unidad_medida, r.estado, r.observaciones FROM recoleccion r INNER JOIN asignacion a ON r.id_asignacion = a.id_asignacion INNER JOIN ruta ru ON a.id_ruta = ru.id_ruta INNER JOIN vehiculo v ON a.id_vehiculo = v.id_vehiculo INNER JOIN personal p ON a.id_personal_responsable = p.id_personal WHERE r.id_recoleccion = $P{ID_RECOLECCION}]]>
	</queryString>
	<field name="id_recoleccion" class="java.lang.Integer"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="nombre_ruta" class="java.lang.String"/>
	<field name="chapa" class="java.lang.String"/>
	<field name="nombre_responsable" class="java.lang.String"/>
	<field name="cantidad_recolectada" class="java.math.BigDecimal"/>
	<field name="unidad_medida" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="observaciones" class="java.lang.String"/>
