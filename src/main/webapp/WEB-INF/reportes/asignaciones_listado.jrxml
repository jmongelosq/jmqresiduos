<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="asignaciones_listado" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" uuid="51000000-1000-0000-0000-000000000001">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="usuarioImpresion" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    a.id_asignacion,
    a.fecha,
    TO_CHAR(a.hora_salida, 'HH24:MI') AS hora_salida,
    TO_CHAR(a.hora_regreso, 'HH24:MI') AS hora_regreso,
    r.nombre AS nombre_ruta,
    v.chapa,
    (p.nombre || ' ' || p.apellido) AS nombre_responsable,
    a.estado
FROM asignacion a
INNER JOIN ruta r
    ON a.id_ruta = r.id_ruta
INNER JOIN vehiculo v
    ON a.id_vehiculo = v.id_vehiculo
INNER JOIN personal p
    ON a.id_personal_responsable = p.id_personal
ORDER BY a.id_asignacion]]>
	</queryString>
	<field name="id_asignacion" class="java.lang.Integer"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="hora_salida" class="java.lang.String"/>
	<field name="hora_regreso" class="java.lang.String"/>
	<field name="nombre_ruta" class="java.lang.String"/>
	<field name="chapa" class="java.lang.String"/>
	<field name="nombre_responsable" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
