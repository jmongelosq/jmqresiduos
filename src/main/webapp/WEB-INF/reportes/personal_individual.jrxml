<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="personal_individual" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="35" bottomMargin="35" uuid="52000000-0000-0000-0000-000000000001">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="idPersonal" class="java.lang.Integer"/>
	<parameter name="usuarioImpresion" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    p.id_personal,
    p.nombre,
    p.apellido,
    p.cedula,
    p.telefono,
    p.direccion,
    p.correo,
    c.nombre_cargo,
    b.nombre AS nombre_barrio,
    p.estado
FROM personal p
LEFT JOIN cargo c
    ON p.id_cargo = c.id_cargo
LEFT JOIN barrio b
    ON p.id_barrio = b.id_barrio
WHERE p.id_personal = $P{idPersonal}]]>
	</queryString>
	<field name="id_personal" class="java.lang.Integer"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="apellido" class="java.lang.String"/>
	<field name="cedula" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="direccion" class="java.lang.String"/>
	<field name="correo" class="java.lang.String"/>
	<field name="nombre_cargo" class="java.lang.String"/>
	<field name="nombre_barrio" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
