<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="pendientes_listado" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" uuid="61000000-0000-0000-0000-000000000001">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="418"/>
	<property name="ireport.y" value="0"/>
	<parameter name="usuarioImpresion" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    f.id_factura,
    f.numero_factura,
    c.nombre AS nombre_cliente,
    c.apellido AS apellido_cliente,
    f.fecha_emision,
    f.fecha_vencimiento,
    f.condicion_venta,
    f.periodo,
    f.plazo_credito,
    f.total AS total_factura,

    COALESCE(
        SUM(
            CASE
                WHEN p.estado = 'PAGADO'
                THEN p.monto
                ELSE 0
            END
        ),
        0
    ) AS total_pagado,

    GREATEST(
        f.total -
        COALESCE(
            SUM(
                CASE
                    WHEN p.estado = 'PAGADO'
                    THEN p.monto
                    ELSE 0
                END
            ),
            0
        ),
        0
    ) AS saldo_pendiente,

    f.estado AS estado_factura,

    CASE
        WHEN GREATEST(
            f.total -
            COALESCE(
                SUM(
                    CASE
                        WHEN p.estado = 'PAGADO'
                        THEN p.monto
                        ELSE 0
                    END
                ),
                0
            ),
            0
        ) = 0
        THEN 'PAGADO'

        WHEN f.fecha_vencimiento IS NOT NULL
             AND f.fecha_vencimiento < CURRENT_DATE
        THEN 'VENCIDO'

        ELSE 'PENDIENTE'
    END AS estado_pendiente,

    CASE
        WHEN GREATEST(
            f.total -
            COALESCE(
                SUM(
                    CASE
                        WHEN p.estado = 'PAGADO'
                        THEN p.monto
                        ELSE 0
                    END
                ),
                0
            ),
            0
        ) > 0
        AND f.fecha_vencimiento IS NOT NULL
        AND f.fecha_vencimiento < CURRENT_DATE
        THEN CURRENT_DATE - f.fecha_vencimiento

        ELSE 0
    END AS dias_vencido

FROM factura f

INNER JOIN clientes c
    ON f.id_cliente = c.id_cliente

LEFT JOIN pago p
    ON f.id_factura = p.id_factura

WHERE f.estado <> 'ANULADA'

GROUP BY
    f.id_factura,
    f.numero_factura,
    c.nombre,
    c.apellido,
    f.fecha_emision,
    f.fecha_vencimiento,
    f.condicion_venta,
    f.periodo,
    f.plazo_credito,
    f.total,
    f.estado

ORDER BY
    CASE
        WHEN GREATEST(
            f.total -
            COALESCE(
                SUM(
                    CASE
                        WHEN p.estado = 'PAGADO'
                        THEN p.monto
                        ELSE 0
                    END
                ),
                0
            ),
            0
        ) > 0
        THEN 0
        ELSE 1
    END,
    f.fecha_vencimiento ASC,
    f.id_factura ASC]]>
	</queryString>
	<field name="id_factura" class="java.lang.Integer"/>
	<field name="numero_factura" class="java.lang.String"/>
	<field name="nombre_cliente" class="java.lang.String"/>
	<field name="apellido_cliente" class="java.lang.String"/>
	<field name="fecha_emision" class="java.sql.Date"/>
	<field name="fecha_vencimiento" class="java.sql.Date"/>
	<field name="condicion_venta" class="java.lang.String"/>
	<field name="periodo" class="java.lang.String"/>
	<field name="plazo_credito" class="java.lang.Integer"/>
	<field name="total_factura" class="java.math.BigDecimal"/>
	<field name="total_pagado" class="java.math.BigDecimal"/>
	<field name="saldo_pendiente" class="java.math.BigDecimal"/>
	<field name="estado_factura" class="java.lang.String"/>
	<field name="estado_pendiente" class="java.lang.String"/>
	<field name="dias_vencido" class="java.lang.Integer"/>
