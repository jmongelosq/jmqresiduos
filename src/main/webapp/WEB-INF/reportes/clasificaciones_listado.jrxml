<?xml version='1.0' encoding='UTF-8'?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="clasificaciones_listado" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" uuid="73000000-1000-0000-0000-000000000001">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="usuarioImpresion" class="java.lang.String"/>
	<queryString>
        <![CDATA[
        SELECT
            c.id_clasificacion,
            c.id_recoleccion,
            r.fecha AS fecha_recoleccion,
            tr.nombre AS nombre_tipo,
            c.cantidad_kg,
            c.observaciones,
            c.estado
        FROM clasificacion_residuo c
        INNER JOIN recoleccion r
            ON c.id_recoleccion = r.id_recoleccion
        INNER JOIN tipos_residuos tr
            ON c.id_tipo = tr.id_tipo
        ORDER BY
            r.fecha DESC,
            c.id_clasificacion DESC
        ]]>
    </queryString>
	<field name="id_clasificacion" class="java.lang.Integer"/>
	<field name="id_recoleccion" class="java.lang.Integer"/>
	<field name="fecha_recoleccion" class="java.sql.Date"/>
	<field name="nombre_tipo" class="java.lang.String"/>
	<field name="cantidad_kg" class="java.lang.Double"/>
	<field name="observaciones" class="java.lang.String"/>
	<field name="estado" class="java.lang.Boolean"/>
