	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="418"/>
	<property name="ireport.y" value="0"/>
	<parameter name="DESDE" class="java.sql.Date"/>
	<parameter name="HASTA" class="java.sql.Date"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT
                f.id_factura,
                f.numero_factura,
                f.fecha_emision,
                f.periodo,
                f.subtotal,
                f.iva_5,
                f.iva_10,
                f.total,
                f.estado,
                c.nombre || ' ' || c.apellido AS nombre_cliente
            FROM factura f
            INNER JOIN clientes c
                ON f.id_cliente = c.id_cliente
            WHERE f.fecha_emision BETWEEN $P{DESDE} AND $P{HASTA}
            ORDER BY f.fecha_emision DESC, f.id_factura DESC]]>
	</queryString>
	<field name="id_factura" class="java.lang.Integer"/>
	<field name="numero_factura" class="java.lang.String"/>
	<field name="fecha_emision" class="java.sql.Date"/>
	<field name="periodo" class="java.lang.String"/>
	<field name="subtotal" class="java.math.BigDecimal"/>
	<field name="iva_5" class="java.math.BigDecimal"/>
	<field name="iva_10" class="java.math.BigDecimal"/>
	<field name="total" class="java.math.BigDecimal"/>
	<field name="estado" class="java.lang.String"/>
	<field name="nombre_cliente" class="java.lang.String"/>
