	<parameter name="logoPath" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
                v.id_vehiculo,
                v.chapa,
                m.marca,
                m.nombre_modelo,
                v.anio,
                v.capacidad,
                v.estado
            FROM vehiculo v
            LEFT JOIN modelo m
                ON v.id_modelo = m.id_modelo
            ORDER BY v.id_vehiculo]]>
	</queryString>
	<field name="id_vehiculo" class="java.lang.Integer"/>
	<field name="chapa" class="java.lang.String"/>
	<field name="marca" class="java.lang.String"/>
	<field name="nombre_modelo" class="java.lang.String"/>
	<field name="anio" class="java.lang.Integer"/>
	<field name="capacidad" class="java.math.BigDecimal"/>
	<field name="estado" class="java.lang.String"/>
