	<queryString>
		<![CDATA[SELECT c.id_clasificacion, c.id_recoleccion, r.fecha, t.nombre AS nombre_tipo, c.cantidad_kg, c.observaciones, c.estado FROM clasificacion_residuo c INNER JOIN recoleccion r ON c.id_recoleccion = r.id_recoleccion INNER JOIN tipos_residuos t ON c.id_tipo = t.id_tipo WHERE c.id_clasificacion = $P{ID_CLASIFICACION}]]>
	</queryString>
