				</textElement>
				<textFieldExpression><![CDATA[$F{estado} == null
                        ? "SIN ESTADO"
                        : (
                            $F{estado}.toString().equalsIgnoreCase("t")
                            || $F{estado}.toString().equalsIgnoreCase("true")
                            || $F{estado}.toString().equalsIgnoreCase("activo")
                            || $F{estado}.toString().equalsIgnoreCase("a")
                            || $F{estado}.toString().equalsIgnoreCase("1")
                            ? "ACTIVO"
