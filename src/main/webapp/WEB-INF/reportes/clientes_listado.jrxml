	<queryString>
		<![CDATA[SELECT
                c.id_cliente,
                c.nombre,
                c.apellido,
                c.cedula,
                c.telefono,
                c.direccion,
                c.correo,
                b.nombre AS nombre_barrio,
                c.estado
            FROM clientes c
            LEFT JOIN barrio b
                ON c.id_barrio = b.id_barrio
            ORDER BY c.id_cliente]]>
	</queryString>
	<field name="id_cliente" class="java.lang.Integer"/>
	<field name="nombre" class="java.lang.String"/>
