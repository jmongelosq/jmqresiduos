				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{direccion} != null &&
                         !$F{direccion}.trim().isEmpty())
                        ? $F{direccion}
                        : ($F{correo} != null ? $F{correo} : "")]]></textFieldExpression>
