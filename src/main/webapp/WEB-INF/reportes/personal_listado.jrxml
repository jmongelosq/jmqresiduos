<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="personal_listado" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" uuid="51000000-0000-0000-0000-000000000001">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="usuarioImpresion" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    p.id_personal,
    p.nombre,
    p.apellido,
    p.cedula,
    p.telefono,
    c.nombre_cargo,
    b.nombre AS nombre_barrio,
    p.estado
FROM personal p
LEFT JOIN cargo c
    ON p.id_cargo = c.id_cargo
LEFT JOIN barrio b
    ON p.id_barrio = b.id_barrio
ORDER BY p.id_personal]]>
	</queryString>
	<field name="id_personal" class="java.lang.Integer"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="apellido" class="java.lang.String"/>
	<field name="cedula" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="nombre_cargo" class="java.lang.String"/>
