<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informe_pago_individual" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="35" bottomMargin="35" uuid="6a71917a-342b-41d7-88d9-f67444122bdc">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="834"/>
	<parameter name="ID_PAGO" class="java.lang.Integer"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT
                p.id_pago,
                f.id_cliente,
                NULL::integer AS id_tarifa,
                p.id_factura,
                p.fecha_pago,
                p.periodo,
                p.monto,
                p.metodo_pago,
                p.numero_recibo,
                p.estado,
                p.observaciones,
                c.nombre AS nombre_cliente,
                c.apellido AS apellido_cliente,
                c.cedula AS cedula_cliente,
                c.direccion AS direccion_cliente,
                f.numero_factura,
                f.fecha_emision,
                f.total AS total_factura,
                f.estado AS estado_factura,
                f.condicion_venta,
                ''::varchar AS nombre_tarifa,
                NULL::numeric AS monto_tarifa
            FROM pago p
            LEFT JOIN factura f
                ON p.id_factura = f.id_factura
            LEFT JOIN clientes c
                ON f.id_cliente = c.id_cliente
            WHERE p.id_pago = $P{ID_PAGO}]]>
	</queryString>
