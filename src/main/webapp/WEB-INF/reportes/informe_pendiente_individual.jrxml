<?xml version='1.0' encoding='UTF-8'?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informe_pendiente_individual" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="35" bottomMargin="35" uuid="4e8a2c71-5d93-4b60-9f12-7c3a6e8d5042">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="ID_CLIENTE" class="java.lang.Integer"/>
	<parameter name="FECHA_INICIO" class="java.sql.Date"/>
	<parameter name="FECHA_FIN" class="java.sql.Date"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT
                c.id_cliente,
                c.nombre,
                c.apellido,
                c.cedula,
                c.direccion,
                b.nombre AS barrio,
                COALESCE(f.total_facturado, 0) AS total_facturado,
                COALESCE(p.total_pagado, 0) AS total_pagado,
                CASE
                    WHEN COALESCE(f.total_facturado, 0) > COALESCE(p.total_pagado, 0)
                    THEN COALESCE(f.total_facturado, 0) - COALESCE(p.total_pagado, 0)
                    ELSE 0
                END AS saldo_pendiente,
                CASE
                    WHEN COALESCE(p.total_pagado, 0) > COALESCE(f.total_facturado, 0)
                    THEN COALESCE(p.total_pagado, 0) - COALESCE(f.total_facturado, 0)
                    ELSE 0
                END AS excedente,
                CASE
                    WHEN COALESCE(f.total_facturado, 0) = 0 AND COALESCE(p.total_pagado, 0) = 0 THEN 'SIN MOVIMIENTOS'
                    WHEN COALESCE(f.total_facturado, 0) = 0 AND COALESCE(p.total_pagado, 0) > 0 THEN 'SIN FACTURA'
                    WHEN COALESCE(p.total_pagado, 0) = 0 THEN 'PENDIENTE'
                    WHEN COALESCE(p.total_pagado, 0) < COALESCE(f.total_facturado, 0) THEN 'PENDIENTE'
                    WHEN COALESCE(p.total_pagado, 0) = COALESCE(f.total_facturado, 0) THEN 'PAGADO'
                    WHEN COALESCE(p.total_pagado, 0) > COALESCE(f.total_facturado, 0) THEN 'PAGO SUPERIOR'
                    ELSE 'SIN MOVIMIENTOS'
                END AS estado_cuenta
            FROM clientes c
            LEFT JOIN barrio b ON c.id_barrio = b.id_barrio
            LEFT JOIN (
                SELECT factura.id_cliente, SUM(factura.total) AS total_facturado
                FROM factura
                WHERE factura.estado IN ('EMITIDA', 'PAGADA')
                  AND factura.id_cliente = $P{ID_CLIENTE}
                  AND (CAST($P{FECHA_INICIO} AS DATE) IS NULL OR factura.fecha_emision >= CAST($P{FECHA_INICIO} AS DATE))
                  AND (CAST($P{FECHA_FIN} AS DATE) IS NULL OR factura.fecha_emision <= CAST($P{FECHA_FIN} AS DATE))
                GROUP BY factura.id_cliente
            ) f ON c.id_cliente = f.id_cliente
            LEFT JOIN (
                SELECT factura.id_cliente, SUM(pago.monto) AS total_pagado
                FROM pago
                INNER JOIN factura ON factura.id_factura = pago.id_factura
                WHERE pago.estado = 'PAGADO'
                  AND factura.id_cliente = $P{ID_CLIENTE}
                  AND (CAST($P{FECHA_INICIO} AS DATE) IS NULL OR factura.fecha_emision >= CAST($P{FECHA_INICIO} AS DATE))
                  AND (CAST($P{FECHA_FIN} AS DATE) IS NULL OR factura.fecha_emision <= CAST($P{FECHA_FIN} AS DATE))
                GROUP BY factura.id_cliente
            ) p ON c.id_cliente = p.id_cliente
            WHERE c.id_cliente = $P{ID_CLIENTE}
              AND CASE
                    WHEN COALESCE(f.total_facturado, 0) = 0 AND COALESCE(p.total_pagado, 0) = 0 THEN 'SIN MOVIMIENTOS'
                    WHEN COALESCE(f.total_facturado, 0) = 0 AND COALESCE(p.total_pagado, 0) > 0 THEN 'SIN FACTURA'
                    WHEN COALESCE(p.total_pagado, 0) = 0 THEN 'PENDIENTE'
                    WHEN COALESCE(p.total_pagado, 0) < COALESCE(f.total_facturado, 0) THEN 'PENDIENTE'
                    WHEN COALESCE(p.total_pagado, 0) = COALESCE(f.total_facturado, 0) THEN 'PAGADO'
                    WHEN COALESCE(p.total_pagado, 0) > COALESCE(f.total_facturado, 0) THEN 'PAGO SUPERIOR'
                    ELSE 'SIN MOVIMIENTOS'
                  END = 'PENDIENTE']]>
	</queryString>
	<field name="id_cliente" class="java.lang.Integer"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="apellido" class="java.lang.String"/>
	<field name="cedula" class="java.lang.String"/>
	<field name="direccion" class="java.lang.String"/>
	<field name="barrio" class="java.lang.String"/>
	<field name="total_facturado" class="java.math.BigDecimal"/>
	<field name="total_pagado" class="java.math.BigDecimal"/>
	<field name="saldo_pendiente" class="java.math.BigDecimal"/>
	<field name="excedente" class="java.math.BigDecimal"/>
	<field name="estado_cuenta" class="java.lang.String"/>
