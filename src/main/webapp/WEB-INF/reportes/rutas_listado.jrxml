	<parameter name="usuarioImpresion" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    r.id_ruta,
    r.nombre,
    r.descripcion,
    b.nombre AS nombre_barrio,
    r.estado
FROM ruta r
LEFT JOIN barrio b
    ON r.id_barrio = b.id_barrio
ORDER BY r.id_ruta]]>
	</queryString>
	<field name="id_ruta" class="java.lang.Integer"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="nombre_barrio" class="java.lang.String"/>
