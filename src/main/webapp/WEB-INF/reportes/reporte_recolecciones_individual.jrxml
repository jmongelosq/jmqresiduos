<?xml version='1.0' encoding='UTF-8'?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_recolecciones_individual" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="35" bottomMargin="35" uuid="5c552770-5974-4b78-a3eb-3bce1c4431b7">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="636"/>
	<parameter name="idRecoleccion" class="java.lang.Integer"/>
	<parameter name="usuarioImpresion" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
                r.id_recoleccion,
                r.fecha,
                r.hora_inicio,
                r.hora_fin,
                ru.nombre AS nombre_ruta,
                v.chapa,
                p.nombre || ' ' || p.apellido AS nombre_personal,
                r.cantidad_recolectada,
                r.unidad_medida,
                r.observaciones,
                r.estado

            FROM recoleccion r

            INNER JOIN asignacion a
                ON r.id_asignacion = a.id_asignacion

            INNER JOIN ruta ru
                ON a.id_ruta = ru.id_ruta

            INNER JOIN vehiculo v
                ON a.id_vehiculo = v.id_vehiculo

            INNER JOIN personal p
                ON a.id_personal_responsable = p.id_personal

            WHERE r.id_recoleccion = $P{idRecoleccion}]]>
	</queryString>
	<field name="id_recoleccion" class="java.lang.Integer"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="hora_inicio" class="java.sql.Time"/>
	<field name="hora_fin" class="java.sql.Time"/>
	<field name="nombre_ruta" class="java.lang.String"/>
	<field name="chapa" class="java.lang.String"/>
	<field name="nombre_personal" class="java.lang.String"/>
	<field name="cantidad_recolectada" class="java.math.BigDecimal"/>
	<field name="unidad_medida" class="java.lang.String"/>
	<field name="observaciones" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
