	<parameter name="usuarioImpresion" class="java.lang.String"/>
	<queryString>
        <![CDATA[
            SELECT
                id_cargo,
                nombre_cargo,
                descripcion,
                CASE
                    WHEN estado = TRUE
                    THEN 'ACTIVO'
                    ELSE 'INACTIVO'
                END AS estado
            FROM cargo
            ORDER BY id_cargo
        ]]>
    </queryString>
	<field name="id_cargo" class="java.lang.Integer"/>
	<field name="nombre_cargo" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
