	<queryString>
		<![CDATA[SELECT
                id_rol,
                nombre_rol,
                descripcion,
                CASE
                    WHEN estado = TRUE
                    THEN 'Activo'
                    ELSE 'Inactivo'
                END AS estado
            FROM roles
            ORDER BY id_rol]]>
