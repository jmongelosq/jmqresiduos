<?xml version='1.0' encoding='UTF-8'?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informe_factura_individual" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="35" bottomMargin="35" uuid="6b7c8d9e-0f1a-42b3-c4d5-e6f708192a30">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="ID_FACTURA" class="java.lang.Integer"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT
                f.id_factura,
                f.id_cliente,
                f.fecha_emision,
                f.timbrado,
                f.fecha_inicio_timbrado,
                f.fecha_fin_timbrado,
                f.establecimiento,
                f.punto_expedicion,
                f.numero_factura,
                f.condicion_venta,
                f.periodo,
                f.subtotal,
                f.iva_5,
                f.iva_10,
                f.total,
                f.estado,
                f.observaciones,
                f.usuario_emision,
                c.nombre AS nombre_cliente,
                c.apellido AS apellido_cliente,
                c.cedula AS cedula_cliente,
                c.direccion AS direccion_cliente,
                d.id_detalle_factura,
                d.id_tarifa,
                d.descripcion,
                d.cantidad,
                d.precio_unitario,
                d.porcentaje_iva,
                d.subtotal AS detalle_subtotal,
                d.monto_iva,
                d.total AS detalle_total,
                t.nombre AS nombre_tarifa
            FROM factura f
            INNER JOIN clientes c
                ON f.id_cliente = c.id_cliente
            LEFT JOIN detalle_factura d
                ON f.id_factura = d.id_factura
            LEFT JOIN tarifa t
                ON d.id_tarifa = t.id_tarifa
            WHERE f.id_factura = $P{ID_FACTURA}
            ORDER BY d.id_detalle_factura]]>
	</queryString>
