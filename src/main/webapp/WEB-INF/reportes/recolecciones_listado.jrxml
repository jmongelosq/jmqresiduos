<?xml version='1.0' encoding='UTF-8'?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="recolecciones_listado" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" uuid="61000000-1000-0000-0000-000000000001">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="usuarioImpresion" class="java.lang.String"/>
	<queryString>
        <![CDATA[
        SELECT
            r.id_recoleccion,
            r.fecha,
            TO_CHAR(r.hora_inicio, 'HH24:MI') AS hora_inicio,
            TO_CHAR(r.hora_fin, 'HH24:MI') AS hora_fin,
            ru.nombre AS nombre_ruta,
            v.chapa,
            (p.nombre || ' ' || p.apellido) AS nombre_personal,
            r.cantidad_recolectada,
            r.unidad_medida,
            r.estado,
            r.observaciones
        FROM recoleccion r
        INNER JOIN asignacion a
            ON r.id_asignacion = a.id_asignacion
        INNER JOIN ruta ru
            ON a.id_ruta = ru.id_ruta
        INNER JOIN vehiculo v
            ON a.id_vehiculo = v.id_vehiculo
        INNER JOIN personal p
            ON a.id_personal_responsable = p.id_personal
        ORDER BY r.fecha DESC, r.id_recoleccion DESC
        ]]>
    </queryString>
	<field name="id_recoleccion" class="java.lang.Integer"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="hora_inicio" class="java.lang.String"/>
	<field name="hora_fin" class="java.lang.String"/>
	<field name="nombre_ruta" class="java.lang.String"/>
	<field name="chapa" class="java.lang.String"/>
	<field name="nombre_personal" class="java.lang.String"/>
	<field name="cantidad_recolectada" class="java.lang.Double"/>
	<field name="unidad_medida" class="java.lang.String"/>
	<field name="estado" class="java.lang.Boolean"/>
	<field name="observaciones" class="java.lang.String"/>
