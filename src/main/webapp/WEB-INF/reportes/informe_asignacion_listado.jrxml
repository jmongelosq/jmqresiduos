<?xml version='1.0' encoding='UTF-8'?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" whenNoDataType="AllSectionsNoDetail" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informe_asignacion_listado" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" uuid="300674da-6e71-48ae-94df-304b51412e2b">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="DESDE" class="java.sql.Date"/>
	<parameter name="HASTA" class="java.sql.Date"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT
            a.id_asignacion,
            a.fecha,
            a.hora_salida,
            a.hora_regreso,
            r.nombre AS nombre_ruta,
            v.chapa,
            p.nombre || ' ' || p.apellido AS nombre_responsable,
            a.estado,
            a.observaciones
        FROM asignacion a
        INNER JOIN ruta r ON a.id_ruta = r.id_ruta
        INNER JOIN vehiculo v ON a.id_vehiculo = v.id_vehiculo
        INNER JOIN personal p ON a.id_personal_responsable = p.id_personal
        WHERE a.fecha BETWEEN $P{DESDE} AND $P{HASTA}
        ORDER BY a.fecha DESC, a.hora_salida DESC NULLS LAST, a.id_asignacion DESC]]>
	</queryString>
	<field name="id_asignacion" class="java.lang.Integer"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="hora_salida" class="java.sql.Time"/>
	<field name="hora_regreso" class="java.sql.Time"/>
	<field name="nombre_ruta" class="java.lang.String"/>
	<field name="chapa" class="java.lang.String"/>
	<field name="nombre_responsable" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="observaciones" class="java.lang.String"/>
