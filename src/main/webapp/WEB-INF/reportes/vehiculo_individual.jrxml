<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="vehiculo_individual" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="35" bottomMargin="35">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="idVehiculo" class="java.lang.Integer"/>
	<parameter name="usuarioImpresion" class="java.lang.String"/>
	<queryString>
        <![CDATA[
SELECT
    v.id_vehiculo,
    v.chapa,
    m.marca,
    m.nombre_modelo,
    v.anio,
    v.capacidad,
    v.unidad_capacidad,
    v.kilometraje,
    v.observaciones,
    v.estado
FROM vehiculo v
LEFT JOIN modelo m
    ON v.id_modelo = m.id_modelo
WHERE v.id_vehiculo = $P{idVehiculo}
        ]]>
    </queryString>
	<field name="id_vehiculo" class="java.lang.Integer"/>
	<field name="chapa" class="java.lang.String"/>
	<field name="marca" class="java.lang.String"/>
	<field name="nombre_modelo" class="java.lang.String"/>
	<field name="anio" class="java.lang.Integer"/>
	<field name="capacidad" class="java.math.BigDecimal"/>
	<field name="unidad_capacidad" class="java.lang.String"/>
	<field name="kilometraje" class="java.math.BigDecimal"/>
	<field name="observaciones" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
