	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="idAsignacion" class="java.lang.Integer"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT
            a.id_asignacion,
            a.id_ruta,
            a.id_vehiculo,
            a.id_personal_responsable,
            a.fecha,
            a.hora_salida,
            a.hora_regreso,
            a.estado,
            a.observaciones,
            r.nombre AS nombre_ruta,
            v.chapa,
            p.nombre || ' ' || p.apellido AS nombre_responsable
        FROM asignacion a
        INNER JOIN ruta r ON a.id_ruta = r.id_ruta
        INNER JOIN vehiculo v ON a.id_vehiculo = v.id_vehiculo
        INNER JOIN personal p ON a.id_personal_responsable = p.id_personal
        WHERE a.id_asignacion = $P{idAsignacion}]]>
	</queryString>
	<field name="id_asignacion" class="java.lang.Integer"/>
	<field name="id_ruta" class="java.lang.Integer"/>
	<field name="id_vehiculo" class="java.lang.Integer"/>
	<field name="id_personal_responsable" class="java.lang.Integer"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="hora_salida" class="java.sql.Time"/>
	<field name="hora_regreso" class="java.sql.Time"/>
	<field name="estado" class="java.lang.String"/>
	<field name="observaciones" class="java.lang.String"/>
	<field name="nombre_ruta" class="java.lang.String"/>
	<field name="chapa" class="java.lang.String"/>
	<field name="nombre_responsable" class="java.lang.String"/>
