	<parameter name="idRol" class="java.lang.Integer"/>
	<parameter name="usuarioImpresion" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
                id_rol,
                nombre_rol,
                descripcion,
                CASE
                    WHEN estado = TRUE
                    THEN 'Activo'
                    ELSE 'Inactivo'
                END AS estado
            FROM roles
            WHERE id_rol = $P{idRol}]]>
	</queryString>
	<field name="id_rol" class="java.lang.Integer"/>
	<field name="nombre_rol" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
