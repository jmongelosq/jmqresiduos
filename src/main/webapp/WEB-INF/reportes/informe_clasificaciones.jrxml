	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="DESDE" class="java.sql.Date"/>
	<parameter name="HASTA" class="java.sql.Date"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT c.id_clasificacion, c.id_recoleccion, r.fecha, t.nombre AS nombre_tipo, c.cantidad_kg, c.observaciones, c.estado FROM clasificacion_residuo c INNER JOIN recoleccion r ON c.id_recoleccion = r.id_recoleccion INNER JOIN tipos_residuos t ON c.id_tipo = t.id_tipo WHERE r.fecha BETWEEN $P{DESDE} AND $P{HASTA} ORDER BY r.fecha DESC, c.id_clasificacion DESC]]>
	</queryString>
	<field name="id_clasificacion" class="java.lang.Integer"/>
	<field name="id_recoleccion" class="java.lang.Integer"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="nombre_tipo" class="java.lang.String"/>
	<field name="cantidad_kg" class="java.math.BigDecimal"/>
	<field name="observaciones" class="java.lang.String"/>
	<field name="estado" class="java.lang.Boolean"/>
