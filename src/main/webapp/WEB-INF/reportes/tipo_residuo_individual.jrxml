	<parameter name="idTipo" class="java.lang.Integer"/>
	<parameter name="usuarioImpresion" class="java.lang.String"/>
	<queryString>
        <![CDATA[
SELECT
    id_tipo,
    nombre,
    descripcion,
    CASE
        WHEN estado = TRUE THEN 'ACTIVO'
        ELSE 'INACTIVO'
    END AS estado
FROM tipos_residuos
WHERE id_tipo = $P{idTipo}
        ]]>
    </queryString>
