	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT id_tarifa, nombre, descripcion, monto, periodicidad, fecha_inicio, fecha_fin, estado
        FROM tarifa
        WHERE fecha_inicio <= $P{HASTA}
          AND (fecha_fin IS NULL OR fecha_fin >= $P{DESDE})
        ORDER BY fecha_inicio ASC, id_tarifa ASC]]>
	</queryString>
	<field name="id_tarifa" class="java.lang.Integer"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="monto" class="java.math.BigDecimal"/>
	<field name="periodicidad" class="java.lang.String"/>
	<field name="fecha_inicio" class="java.sql.Date"/>
	<field name="fecha_fin" class="java.sql.Date"/>
	<field name="estado" class="java.lang.Boolean"/>
